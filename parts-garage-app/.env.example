# --- Supabase ---
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Same page, "service_role" secret (NOT the anon key). Only used server-side
# by the daily backup job. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Backblaze B2 (private bucket for photos, videos and backups) ---
# Bucket endpoint, shown on the Buckets page
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_BUCKET_NAME=your-bucket-name
# Application Keys page — key restricted to the bucket above, Read and Write
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key

# --- Daily backup job ---
# Any long random string. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=a-long-random-string

# --- Invoice header (printed on every invoice) ---
NEXT_PUBLIC_COMPANY_NAME=Parts Garage
NEXT_PUBLIC_COMPANY_GSTIN=
NEXT_PUBLIC_COMPANY_STATE=
NEXT_PUBLIC_COMPANY_ADDRESS=
